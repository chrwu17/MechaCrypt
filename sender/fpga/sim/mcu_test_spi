module mcu_test_spi (
    input  logic       clk,           // FPGA clock
    input  logic       reset,         // Active high reset
    
    // SPI signals
    input  logic       sclk,          // SPI clock from MCU
    input  logic       mosi,          // SPI data from MCU
    input  logic       cs_n,          // Chip select (active low)
    input  logic       load,          // Load signal from MCU
    
    // Test outputs
    output logic       done,          // Done signal to MCU
    output logic       led_block0_pt, // LED: Block 0 plaintext match
    output logic       led_block0_key,// LED: Block 0 key valid
    output logic       led_block1_pt, // LED: Block 1 plaintext match
    output logic       led_block1_key // LED: Block 1 key valid
);

    // Expected plaintext for block 0: "This is a test r"
    localparam logic [127:0] EXPECTED_BLOCK0 = {
        8'h54, 8'h68, 8'h69, 8'h73, 8'h20, 8'h69, 8'h73, 8'h20,
        8'h61, 8'h20, 8'h74, 8'h65, 8'h73, 8'h74, 8'h20, 8'h72
    };
    
    // Expected plaintext for block 1: "un" + padding (0E repeated)
    localparam logic [127:0] EXPECTED_BLOCK1 = {
        8'h75, 8'h6E, 8'h0E, 8'h0E, 8'h0E, 8'h0E, 8'h0E, 8'h0E,
        8'h0E, 8'h0E, 8'h0E, 8'h0E, 8'h0E, 8'h0E, 8'h0E, 8'h0E
    };

    // SPI receiver state machine
    typedef enum logic [2:0] {
        IDLE        = 3'd0,
        RECV_PT     = 3'd1,
        RECV_KEY    = 3'd2,
        CHECK       = 3'd3,
        ASSERT_DONE = 3'd4,
        WAIT_LOAD   = 3'd5
    } state_t;
    
    state_t state;
    
    // Shift registers for receiving data
    logic [127:0] plaintext_shift;
    logic [127:0] key_shift;
    logic [7:0]   bit_count;
    logic [7:0]   byte_count;
    
    // Storage for received blocks
    logic [127:0] received_pt;
    logic [127:0] received_key;
    
    // Block counter
    logic [1:0] block_num;
    
    // Edge detection for sclk
    logic sclk_d1, sclk_d2;
    logic sclk_rising;
    
    always_ff @(posedge clk) begin
        sclk_d1 <= sclk;
        sclk_d2 <= sclk_d1;
    end
    
    assign sclk_rising = sclk_d1 && !sclk_d2;
    
    // Edge detection for load
    logic load_d1, load_d2;
    logic load_rising;
    
    always_ff @(posedge clk) begin
        load_d1 <= load;
        load_d2 <= load_d1;
    end
    
    assign load_rising = load_d1 && !load_d2;
    
    // Main state machine
    always_ff @(posedge clk) begin
        if (reset) begin
            state <= IDLE;
            done <= 1'b0;
            led_block0_pt <= 1'b0;
            led_block0_key <= 1'b0;
            led_block1_pt <= 1'b0;
            led_block1_key <= 1'b0;
            block_num <= 2'd0;
            bit_count <= 8'd0;
            byte_count <= 8'd0;
            plaintext_shift <= 128'd0;
            key_shift <= 128'd0;
            received_pt <= 128'd0;
            received_key <= 128'd0;
        end else begin
            case (state)
                IDLE: begin
                    done <= 1'b0;
                    if (load_rising && !cs_n) begin
                        state <= RECV_PT;
                        bit_count <= 8'd0;
                        byte_count <= 8'd0;
                        plaintext_shift <= 128'd0;
                        key_shift <= 128'd0;
                    end
                end
                
                RECV_PT: begin
                    if (!cs_n && sclk_rising) begin
                        // Shift in MOSI bit (MSB first)
                        plaintext_shift <= {plaintext_shift[126:0], mosi};
                        bit_count <= bit_count + 1;
                        
                        if (bit_count == 8'd7) begin
                            bit_count <= 8'd0;
                            byte_count <= byte_count + 1;
                            
                            if (byte_count == 8'd15) begin
                                // Finished receiving 16 bytes of plaintext
                                received_pt <= {plaintext_shift[126:0], mosi};
                                byte_count <= 8'd0;
                                state <= RECV_KEY;
                            end
                        end
                    end
                    
                    // Check for CS going high (end of transmission)
                    if (cs_n) begin
                        state <= IDLE;
                    end
                end
                
                RECV_KEY: begin
                    if (!cs_n && sclk_rising) begin
                        // Shift in MOSI bit (MSB first)
                        key_shift <= {key_shift[126:0], mosi};
                        bit_count <= bit_count + 1;
                        
                        if (bit_count == 8'd7) begin
                            bit_count <= 8'd0;
                            byte_count <= byte_count + 1;
                            
                            if (byte_count == 8'd15) begin
                                // Finished receiving 16 bytes of key
                                received_key <= {key_shift[126:0], mosi};
                                state <= CHECK;
                            end
                        end
                    end
                    
                    // Check for CS going high (end of transmission)
                    if (cs_n) begin
                        state <= CHECK;
                    end
                end
                
                CHECK: begin
                    // Check the received data based on block number
                    if (block_num == 2'd0) begin
                        // Block 0 checks
                        if (received_pt == EXPECTED_BLOCK0)
                            led_block0_pt <= 1'b1;
                        
                        if (received_key != 128'd0)
                            led_block0_key <= 1'b1;
                    end else if (block_num == 2'd1) begin
                        // Block 1 checks
                        if (received_pt == EXPECTED_BLOCK1)
                            led_block1_pt <= 1'b1;
                        
                        if (received_key != 128'd0)
                            led_block1_key <= 1'b1;
                    end
                    
                    state <= ASSERT_DONE;
                end
                
                ASSERT_DONE: begin
                    // Assert done signal
                    done <= 1'b1;
                    state <= WAIT_LOAD;
                end
                
                WAIT_LOAD: begin
                    // Wait for load to go low (MCU acknowledges done)
                    if (!load) begin
                        done <= 1'b0;
                        block_num <= block_num + 1;
                        
                        if (block_num < 2'd1) begin
                            // Wait for next block
                            state <= IDLE;
                        end else begin
                            // All blocks received, stay in this state
                            state <= WAIT_LOAD;
                        end
                    end
                end
                
                default: state <= IDLE;
            endcase
        end
    end

endmodule