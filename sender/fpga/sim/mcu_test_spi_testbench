/////////////////////////////////////////////
// mcu_test_spi_testbench
//   Simulates MCU sending multiple blocks
//   Focus on load/done timing and data transfer
/////////////////////////////////////////////

module mcu_test_spi_testbench();

    logic sck, sdi, sdo, load, done;
    integer i, block;
    
    // Instantiate device under test
    mcu_test_spi dut(
        .sck(sck),
        .sdi(sdi),
        .sdo(sdo),
        .load(load),
        .done(done)
    );
    
    // Clock generation - 10MHz SPI clock
    initial begin
        sck = 0;
        forever #50 sck = ~sck;  // 100ns period
    end
    
    // Test stimulus - send 5 blocks
    initial begin
        $display("MCU SPI Transaction Test - 5 Blocks");
        
        // Initialize
        load = 0;
        sdi = 0;
        #200;
        
        // Send 5 blocks
        for (block = 0; block < 5; block = block + 1) begin
            $display("\n=== Block %0d ===", block);
            
            // Assert load
            $display("Time %0t: LOAD asserted - starting to send data", $time);
            load = 1;
            #100;
            
            // Shift in 256 bits (16 bytes plaintext + 16 bytes key)
            $display("Time %0t: Shifting in 256 bits...", $time);
            for (i = 0; i < 256; i = i + 1) begin
                @(negedge sck);
                sdi = $random;
            end
            
            // Deassert load
            @(negedge sck);
            load = 0;
            $display("Time %0t: LOAD deasserted", $time);
            
            // Wait for done
            wait(done);
            $display("Time %0t: DONE asserted - ready to read", $time);
            
            #500;
            
            // Read back 128 bits
            $display("Time %0t: Reading 128 bits back...", $time);
            for (i = 0; i < 128; i = i + 1) begin
                @(posedge sck);
            end
            
            $display("Time %0t: Block %0d complete\n", $time, block);
            
            // Gap between blocks
            #1000;
        end
        
        $display("\n=== All 5 blocks transmitted ===");
        $display("Check waveforms for:");
        $display("  - load/done timing");
        $display("  - plaintext and key registers");
        $display("  - bit_count progression");
        
        #5000;
        $finish;
    end

endmodule